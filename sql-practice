Part A - Database & Table Creation

    
1->  CREATE DATABASE company_db;

2-> USE company_db;

3-> CREATE TABLE employees (
    employee_id INT PRIMARY KEY,
    employee_name VARCHAR(100),
    department VARCHAR(50),
    salary DECIMAL(10,2),
    city VARCHAR(50),
    joining_date DATE,
    status VARCHAR(20)
);

4-> SHOW COLUMNS FROM employees;

5-> SHOW TABLES;


